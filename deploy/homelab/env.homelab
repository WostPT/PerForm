# PerForm on the homelab. install-system.sh copies this to ~/perform/.env and fills in HOST
# (the server's Tailscale name, e.g. homelab.<tailnet>.ts.net). Edit ~/perform/.env afterwards,
# not this file. Every other setting is documented in .env.example.
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:deploy/homelab/compose.homelab.yml

# Passkeys are bound to the hostname; the app is served on port 8443 of it (443 is taken).
RP_ID=HOST
ORIGIN=https://HOST:8443
RP_NAME=PerForm

# Only on the server itself: Tailscale Serve is the way in. 8080 is Pi-hole, 8090 another app.
WEB_PORT=127.0.0.1:8091

# The first profile created becomes the admin (needed to turn on the AI coach).
FIRST_USER_ADMIN=1
# A password next to the passkey, for a desktop without a fingerprint reader.
PASSWORD_LOGIN=1
# No anonymous use: every session belongs to a profile on this server.
ALLOW_GUEST=0
